# App
APP_NAME=FastAPI RDS Backend
DEBUG=false

# AWS RDS MySQL
DB_HOST=your-db.xxxxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=admin
DB_PASSWORD=your_password
DB_NAME=your_db_name

# Optional: path to the RDS CA bundle to enforce SSL
DB_SSL_CA=

# Optional: full URL that overrides all DB_* values (e.g. sqlite:///./local.db)
DATABASE_URL=

# Auth (required). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional: frontend origins allowed to call the API (JSON list)
# CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Read-only PostgreSQL database (AWS RDS). Leave READ_DB_HOST empty to disable it.
READ_DB_HOST=your-read-db.xxxxxxxx.ap-south-1.rds.amazonaws.com
READ_DB_PORT=5432
READ_DB_USER=your_read_user
READ_DB_PASSWORD=your_read_password
READ_DB_NAME=your_read_db_name
READ_DB_SCHEMA=public

# READ_DB_SSL_CA: path to the AWS RDS certificate bundle, used to verify the server certificate.
# Download from https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# If empty, SSL is still used but the certificate is not verified.
READ_DB_SSL_CA=global-bundle.pem

# Optional: full URL that overrides all READ_DB_* values except READ_DB_SSL_CA
# (e.g. postgresql+pg8000://user:password@host:5432/dbname)
READ_DATABASE_URL=
